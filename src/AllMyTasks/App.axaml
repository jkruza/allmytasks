<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AllMyTasks.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AllMyTasks/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent supplies control templates, focus and accessibility; the palettes point its accent at ours. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#3B82F6" />
        <ColorPaletteResources x:Key="Dark" Accent="#3B82F6" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AllMyTasks/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
