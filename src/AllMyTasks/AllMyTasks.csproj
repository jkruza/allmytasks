<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AllMyTasks</RootNamespace>
    <AssemblyName>AllMyTasks</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Listed so packages.lock.json covers every release target and locked restore works in CI. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AllMyTasks.Core\AllMyTasks.Core.csproj" />
    <ProjectReference Include="..\AllMyTasks.Storage.Sqlite\AllMyTasks.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\AllMyTasks.Providers.ICal\AllMyTasks.Providers.ICal.csproj" />
    <ProjectReference Include="..\AllMyTasks.Secrets\AllMyTasks.Secrets.csproj" />
  </ItemGroup>
</Project>
