<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AllMyTasks.ViewModels"
        x:Class="AllMyTasks.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
    <StackPanel Spacing="8">
      <TextBlock Text="Calendar" FontWeight="SemiBold" />
      <StackPanel Spacing="4">
        <TextBlock Text="Week starts on" />
        <ComboBox ItemsSource="{Binding WeekStartOptions}" SelectedItem="{Binding SelectedWeekStart}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:WeekStartOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock Text="Startup" FontWeight="SemiBold" />
      <CheckBox IsChecked="{Binding LaunchAtLogin}" IsEnabled="{Binding CanChangeLaunchAtLogin}">
        <TextBlock Text="Launch All My Tasks when I log in" TextWrapping="Wrap" />
      </CheckBox>
      <CheckBox Margin="24,0,0,0" IsChecked="{Binding StartInTrayAtLogin}" IsEnabled="{Binding LaunchAtLogin}">
        <TextBlock Text="Start minimized to tray (only when started at login)" TextWrapping="Wrap" />
      </CheckBox>
      <TextBlock Text="{Binding AutostartMessage}" IsVisible="{Binding AutostartMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock Text="Window" FontWeight="SemiBold" />
      <CheckBox IsChecked="{Binding CloseToTray}">
        <TextBlock Text="Keep running in the system tray when the window is closed" TextWrapping="Wrap" />
      </CheckBox>
    </StackPanel>
    <Button Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Click="OnClose" />
  </StackPanel>
</Window>
