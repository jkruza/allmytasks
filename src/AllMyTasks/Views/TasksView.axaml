<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.TasksView"
             x:DataType="vm:TasksViewModel">
  <DockPanel Margin="12">
    <!-- Filter bar: search and status first, then one chip per filter that opens its own flyout,
         then sort and grouping on the right. See docs/design/all-tasks-filter.md. -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBox Text="{Binding SearchText}" PlaceholderText="Search title and notes" MinWidth="120" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <ToggleButton Classes="seg" Content="Open" IsChecked="{Binding IsStatusOpen, Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Open" />
          <ToggleButton Classes="seg" Content="Completed" IsChecked="{Binding IsStatusCompleted, Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Completed" />
          <ToggleButton Classes="seg" Content="Cancelled" IsChecked="{Binding IsStatusCancelled, Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Cancelled" />
          <ToggleButton Classes="seg" Content="All" IsChecked="{Binding IsStatusAll, Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="All" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <WrapPanel Orientation="Horizontal">
          <DropDownButton Classes="chip" Classes.active="{Binding IsDueActive}" Content="{Binding DueChip}" Margin="0,0,6,4">
            <DropDownButton.Flyout>
              <Flyout>
                <ComboBox ItemsSource="{x:Static vm:TasksViewModel.DueChoices}" SelectedItem="{Binding Due}" MinWidth="180" />
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <DropDownButton Classes="chip" Classes.active="{Binding IsPriorityActive}" Content="{Binding PriorityChip}" Margin="0,0,6,4">
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel MinWidth="160">
                  <CheckBox Content="High" IsChecked="{Binding High}" />
                  <CheckBox Content="Medium" IsChecked="{Binding Medium}" />
                  <CheckBox Content="Low" IsChecked="{Binding Low}" />
                  <CheckBox Content="None" IsChecked="{Binding NoPriority}" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <DropDownButton Classes="chip" Classes.active="{Binding IsLabelsActive}" Content="{Binding LabelsChip}" Margin="0,0,6,4">
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel Spacing="6" MinWidth="220">
                  <TextBox Text="{Binding LabelsText}" PlaceholderText="Labels, comma-separated" />
                  <CheckBox Content="Must have all of them" IsChecked="{Binding AllLabels}" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button Classes="tool" Content="Clear filters" IsVisible="{Binding HasActiveFilters}" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,4" />
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Opacity="0.7" />
          <DropDownButton Classes="tool" Content="{Binding SortSummary}">
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel Spacing="8" MinWidth="200">
                  <TextBlock Text="Sort by" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{x:Static vm:TasksViewModel.SortChoices}" SelectedItem="{Binding Sort}" HorizontalAlignment="Stretch" />
                  <ToggleButton Content="Descending" IsChecked="{Binding Descending}" />
                  <TextBlock Text="Group by" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{x:Static vm:TasksViewModel.GroupChoices}" SelectedItem="{Binding Grouping}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </StackPanel>
      </Grid>
    </StackPanel>
    <ListBox ItemsSource="{Binding Items}" SelectionMode="Single">
      <ListBox.DataTemplates>
        <DataTemplate DataType="vm:TaskGroupHeader">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,2">
            <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CountText}" Opacity="0.6" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:TaskRowItem">
          <Grid ColumnDefinitions="Auto,4,*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="{Binding Indent}" Opacity="{Binding Opacity}"
                AutomationProperties.Name="{Binding Spoken}" Background="Transparent" c:EntryActivation.Enabled="True">
            <TextBlock Grid.Column="0" Text="{Binding Glyph}" VerticalAlignment="Center" IsVisible="{Binding CannotChange}" />
            <!-- A button only for tasks whose source allows changes; see docs/design/complete-tasks.md. -->
            <Button Grid.Column="0" Content="{Binding Glyph}" Command="{Binding ToggleCommand}" IsVisible="{Binding CanChange}"
                    Background="Transparent" BorderThickness="0" Padding="2,0" VerticalAlignment="Center" Focusable="False"
                    AutomationProperties.Name="{Binding ToggleName}" ToolTip.Tip="{Binding ToggleName}" />
            <Border Grid.Column="1" Background="{Binding Accent}" CornerRadius="2" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding LabelsText}" FontSize="11" Opacity="0.7" />
                <TextBlock Text="{Binding SubtaskText}" FontSize="11" Opacity="0.7" />
                <TextBlock Text="{Binding FailedText}" IsVisible="{Binding HasFailed}" FontSize="11" Foreground="IndianRed" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding PriorityText}" Foreground="DarkOrange" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding DueText}" VerticalAlignment="Center" Classes.overdue="{Binding IsOverdue}" />
            <Border Grid.Column="5" Padding="6,1" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" VerticalAlignment="Center">
              <TextBlock Text="{Binding CollectionName}" FontSize="11" />
            </Border>
            <TextBlock Grid.Column="6" Text="{Binding SourceName}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.DataTemplates>
      <ListBox.Styles>
        <Style Selector="TextBlock.overdue">
          <Setter Property="Foreground" Value="IndianRed" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </DockPanel>
</UserControl>
