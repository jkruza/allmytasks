<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.TasksView"
             x:DataType="vm:TasksViewModel">
  <DockPanel Margin="12">
    <!-- Filter bar: search and status first, then one chip per filter that opens its own flyout,
         then sort and grouping on the right. See docs/design/all-tasks-filter.md. -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBox Text="{Binding SearchText}" PlaceholderText="Filter this list by title and notes (Ctrl+F searches everything)" MinWidth="120" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding ShowStatusAndDue}">
          <ToggleButton Classes="seg" Content="Open" IsChecked="{Binding IsStatusOpen, Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Open" />
          <ToggleButton Classes="seg" Content="Completed" IsChecked="{Binding IsStatusCompleted, Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Completed" />
          <ToggleButton Classes="seg" Content="Cancelled" IsChecked="{Binding IsStatusCancelled, Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Cancelled" />
          <ToggleButton Classes="seg" Content="All" IsChecked="{Binding IsStatusAll, Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="All" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <WrapPanel Orientation="Horizontal">
          <!-- Saved filters: named setups of the controls below; see docs/design/search-and-saved-filters.md. -->
          <DropDownButton Classes="chip" Classes.active="{Binding HasActiveSaved}" Content="{Binding FiltersLabel}" Margin="0,0,6,4" IsVisible="{Binding ShowStatusAndDue}">
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel Spacing="6" MinWidth="300">
                  <TextBlock Classes="section" Text="Saved filters" />
                  <TextBlock Classes="small" Text="None yet. Set up the list, give it a name below and save it." IsVisible="{Binding HasNoSavedFilters}"
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding SavedFilters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SavedFilterItem">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                          <Button Classes="tool" Content="{Binding Label}" Command="{Binding ApplyCommand}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding Name}" />
                          <Button Grid.Column="1" Classes="tool" Content="↑" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                                  AutomationProperties.Name="Move up" ToolTip.Tip="Move up" />
                          <Button Grid.Column="2" Classes="tool" Content="↓" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                                  AutomationProperties.Name="Move down" ToolTip.Tip="Move down" />
                          <Button Grid.Column="3" Classes="tool" Content="✕" Command="{Binding DeleteCommand}"
                                  AutomationProperties.Name="Delete" ToolTip.Tip="Delete" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator />
                  <TextBox Text="{Binding FilterName}" PlaceholderText="Name" AutomationProperties.Name="Filter name" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="Save as new" Command="{Binding SaveCurrentCommand}" Margin="0,0,6,4" />
                    <Button Content="Update" Command="{Binding UpdateActiveCommand}" IsVisible="{Binding HasActiveSaved}" Margin="0,0,6,4"
                            ToolTip.Tip="Replace the active filter with what the controls show now" />
                    <Button Content="Revert" Command="{Binding RevertActiveCommand}" IsVisible="{Binding IsModified}" Margin="0,0,6,4"
                            ToolTip.Tip="Go back to the active filter as saved" />
                    <Button Content="Rename" Command="{Binding RenameActiveCommand}" IsVisible="{Binding HasActiveSaved}" Margin="0,0,6,4" />
                  </WrapPanel>
                  <Button Content="Clear" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"
                          ToolTip.Tip="Back to open tasks, any due date" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <DropDownButton Classes="chip" Classes.active="{Binding IsDueActive}" Content="{Binding DueChip}" Margin="0,0,6,4" IsVisible="{Binding ShowStatusAndDue}">
            <DropDownButton.Flyout>
              <Flyout>
                <ComboBox ItemsSource="{x:Static vm:TasksViewModel.DueChoices}" SelectedItem="{Binding Due}" MinWidth="180" />
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <DropDownButton Classes="chip" Classes.active="{Binding IsPriorityActive}" Content="{Binding PriorityChip}" Margin="0,0,6,4">
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel MinWidth="160">
                  <CheckBox Content="High" IsChecked="{Binding High}" />
                  <CheckBox Content="Medium" IsChecked="{Binding Medium}" />
                  <CheckBox Content="Low" IsChecked="{Binding Low}" />
                  <CheckBox Content="None" IsChecked="{Binding NoPriority}" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <DropDownButton Classes="chip" Classes.active="{Binding IsLabelsActive}" Content="{Binding LabelsChip}" Margin="0,0,6,4">
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel Spacing="6" MinWidth="220">
                  <TextBox Text="{Binding LabelsText}" PlaceholderText="Labels, comma-separated" />
                  <CheckBox Content="Must have all of them" IsChecked="{Binding AllLabels}" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button Classes="tool" Content="Clear filters" IsVisible="{Binding HasActiveFilters}" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,4" />
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <TextBlock Classes="small" Text="{Binding Summary}" VerticalAlignment="Center" />
          <DropDownButton Classes="tool" Content="{Binding SortSummary}">
            <DropDownButton.Flyout>
              <Flyout>
                <StackPanel Spacing="8" MinWidth="200">
                  <TextBlock Classes="section" Text="Sort by" />
                  <ComboBox ItemsSource="{x:Static vm:TasksViewModel.SortChoices}" SelectedItem="{Binding Sort}" HorizontalAlignment="Stretch" />
                  <ToggleButton Content="Descending" IsChecked="{Binding Descending}" />
                  <TextBlock Classes="section" Text="Group by" />
                  <ComboBox ItemsSource="{x:Static vm:TasksViewModel.GroupChoices}" SelectedItem="{Binding Grouping}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </StackPanel>
      </Grid>
      <TextBlock Classes="warning" Text="{Binding MissingNotice}" IsVisible="{Binding HasMissingNotice}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="empty" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Margin="4,16" />
    <ListBox Classes="dense" Classes.roomy="{Binding IsInbox}" ItemsSource="{Binding Items}" SelectionMode="Single">
      <ListBox.DataTemplates>
        <DataTemplate DataType="vm:TaskGroupHeader">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,2">
            <TextBlock Classes="section" Text="{Binding Text}" />
            <TextBlock Classes="meta" Text="{Binding CountText}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:TaskRowItem">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="{Binding Indent}" Opacity="{Binding Opacity}"
                AutomationProperties.Name="{Binding Spoken}" Background="Transparent" c:EntryActivation.Enabled="True">
            <TextBlock Grid.Column="0" Text="{Binding Glyph}" VerticalAlignment="Center" IsVisible="{Binding CannotChange}" />
            <!-- A button only for tasks whose source allows changes; see docs/design/complete-tasks.md. -->
            <Button Grid.Column="0" Content="{Binding Glyph}" Command="{Binding ToggleCommand}" IsVisible="{Binding CanChange}"
                    Background="Transparent" BorderThickness="0" Padding="2,0" VerticalAlignment="Center" Focusable="False"
                    AutomationProperties.Name="{Binding ToggleName}" ToolTip.Tip="{Binding ToggleName}" />
            <Border Grid.Column="1" Classes="dot" Background="{Binding Accent}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="meta" Text="{Binding LabelsText}" />
                <TextBlock Classes="meta" Text="{Binding SubtaskText}" />
                <TextBlock Classes="meta overdue" Text="{Binding FailedText}" IsVisible="{Binding HasFailed}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding PriorityText}" Foreground="{DynamicResource AmtWarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Classes="small" Text="{Binding DueText}" VerticalAlignment="Center" Classes.overdue="{Binding IsOverdue}" />
            <Border Grid.Column="5" Classes="badge" VerticalAlignment="Center">
              <TextBlock Classes="meta" Text="{Binding CollectionName}" />
            </Border>
            <TextBlock Grid.Column="6" Classes="meta" Text="{Binding SourceName}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.DataTemplates>
      <!-- Dense rows are 28 px; the Inbox is roomier at 36 px. -->
      <ListBox.Styles>
        <Style Selector="ListBox.dense ListBoxItem">
          <Setter Property="MinHeight" Value="28" />
          <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="ListBox.dense.roomy ListBoxItem">
          <Setter Property="MinHeight" Value="36" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </DockPanel>
</UserControl>
