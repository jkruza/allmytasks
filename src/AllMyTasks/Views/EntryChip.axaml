<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             x:Class="AllMyTasks.Views.EntryChip"
             x:DataType="vm:EntryItem">
  <Border Background="{Binding ChipBackground}" CornerRadius="3" Padding="4,1" Opacity="{Binding Opacity}"
          AutomationProperties.Name="{Binding Spoken}" ToolTip.Tip="{Binding Spoken}">
    <TextBlock Foreground="{Binding ChipForeground}" FontSize="12" TextTrimming="CharacterEllipsis">
      <Run Text="{Binding Glyph}" /><Run Text="{Binding Title}" />
    </TextBlock>
  </Border>
</UserControl>
