<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.EntryChip"
             x:DataType="vm:EntryItem">
  <Border Classes="chip-box" Background="{Binding ChipBackground}" BorderBrush="{Binding Accent}" Opacity="{Binding Opacity}"
          AutomationProperties.Name="{Binding Spoken}" ToolTip.Tip="{Binding Spoken}" c:EntryActivation.Enabled="True">
    <TextBlock TextTrimming="CharacterEllipsis">
      <Run Text="{Binding Glyph}" /><Run Text="{Binding Title}" />
    </TextBlock>
  </Border>
</UserControl>
