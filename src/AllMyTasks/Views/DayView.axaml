<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:views="using:AllMyTasks.Views"
             x:Class="AllMyTasks.Views.DayView"
             x:DataType="vm:DayViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,16" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
      <!-- Date header: the question this view answers is "what do I do today?", so the date leads. -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="display" Text="{Binding DayNumber}" VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="title" Text="{Binding WeekdayText}" />
          <TextBlock Classes="small" Text="{Binding SummaryText}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Classes="empty" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Margin="0,48" />

      <StackPanel IsVisible="{Binding HasOverdue}" Spacing="2">
        <TextBlock Classes="overdue" Text="Overdue" />
        <ItemsControl ItemsSource="{Binding Overdue}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryItem"><views:EntryRow /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding HasAllDay}" Spacing="2">
        <TextBlock Classes="section" Text="All day and due" />
        <ItemsControl ItemsSource="{Binding AllDay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryItem"><views:EntryRow /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Timeline}">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:EntryItem"><views:EntryRow /></DataTemplate>
          <DataTemplate DataType="vm:NowMarker">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4" AutomationProperties.Name="Now">
              <TextBlock Text="Now" Foreground="{DynamicResource AmtAccentBrush}" FontWeight="SemiBold" FontSize="{DynamicResource AmtFontSizeSmall}" />
              <Border Grid.Column="1" Height="2" Background="{DynamicResource AmtAccentBrush}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
