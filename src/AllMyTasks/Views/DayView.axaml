<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:views="using:AllMyTasks.Views"
             x:Class="AllMyTasks.Views.DayView"
             x:DataType="vm:DayViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,12" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Opacity="0.6" FontSize="16"
                 HorizontalAlignment="Center" Margin="0,48" />

      <StackPanel IsVisible="{Binding HasOverdue}" Spacing="2">
        <TextBlock Text="Overdue" FontWeight="SemiBold" Foreground="IndianRed" />
        <ItemsControl ItemsSource="{Binding Overdue}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryItem"><views:EntryRow /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding HasAllDay}" Spacing="2">
        <TextBlock Text="All day" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding AllDay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryItem"><views:EntryRow /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Timeline}">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:EntryItem"><views:EntryRow /></DataTemplate>
          <DataTemplate DataType="vm:NowMarker">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4" AutomationProperties.Name="Now">
              <TextBlock Text="Now" Foreground="IndianRed" FontWeight="SemiBold" FontSize="12" />
              <Border Grid.Column="1" Height="2" Background="IndianRed" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
