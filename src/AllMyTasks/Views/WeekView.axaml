<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:views="using:AllMyTasks.Views"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.WeekView"
             x:DataType="vm:WeekViewModel">
  <DockPanel Margin="8">
    <!-- Day headers -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="56,*">
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WeekDayViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,4"
                        AutomationProperties.Name="{Binding Header}">
              <TextBlock Classes="small" Text="{Binding WeekdayText}" VerticalAlignment="Center" />
              <Border Classes="daynum" Classes.today="{Binding IsToday}">
                <TextBlock Text="{Binding DayNumber}" />
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <!-- All-day strip -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="56,*" IsVisible="{Binding HasAllDay}" Margin="0,0,0,4">
      <TextBlock Classes="meta" Text="All day" VerticalAlignment="Top" />
      <ItemsControl Grid.Column="1" ItemsSource="{Binding AllDayBars}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><c:SpanBarPanel ColumnCount="{ReflectionBinding $parent[UserControl].DataContext.ColumnCount}" LaneHeight="22" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SpanBarItem">
            <Border Classes="chip-box" Background="{Binding ChipBackground}" BorderBrush="{Binding Accent}" ToolTip.Tip="{Binding Spoken}"
                    AutomationProperties.Name="{Binding Spoken}" c:EntryActivation.Enabled="True">
              <TextBlock Text="{Binding BarText}" TextTrimming="CharacterEllipsis" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <ScrollViewer>
      <Grid ColumnDefinitions="56,*">
        <!-- Hour labels -->
        <ItemsControl ItemsSource="{Binding HourLabels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="meta" Text="{Binding}" Height="48" HorizontalAlignment="Right" Margin="0,0,6,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WeekDayViewModel">
              <Border Classes="cell" Classes.today="{Binding IsToday}" BorderThickness="1,0,0,0">
                <ItemsControl ItemsSource="{Binding Entries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <c:TimelinePanel PixelsPerMinute="0.8"
                                       OriginMinute="{ReflectionBinding $parent[UserControl].DataContext.VisibleStartMinute}"
                                       TimelineHeight="{ReflectionBinding $parent[UserControl].DataContext.TimelineHeight}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimedEntryItem">
                      <Border Classes="chip-box" Background="{Binding ChipBackground}" BorderBrush="{Binding Accent}" Opacity="{Binding Opacity}"
                              ToolTip.Tip="{Binding Spoken}" AutomationProperties.Name="{Binding Spoken}" ClipToBounds="True"
                              c:EntryActivation.Enabled="True">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource AmtFontSizeMeta}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="meta" Text="{Binding TimeText}" Foreground="{DynamicResource AmtInkBrush}" Opacity="0.75" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
