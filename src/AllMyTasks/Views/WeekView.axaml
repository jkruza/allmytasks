<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:views="using:AllMyTasks.Views"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.WeekView"
             x:DataType="vm:WeekViewModel">
  <DockPanel Margin="8">
    <!-- Day headers -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="56,*">
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WeekDayViewModel">
            <TextBlock Text="{Binding Header}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,4" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <!-- All-day strip -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="56,*" IsVisible="{Binding HasAllDay}" Margin="0,0,0,4">
      <TextBlock Text="All day" FontSize="11" Opacity="0.7" VerticalAlignment="Top" />
      <ItemsControl Grid.Column="1" ItemsSource="{Binding AllDayBars}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><c:SpanBarPanel ColumnCount="{ReflectionBinding $parent[UserControl].DataContext.ColumnCount}" LaneHeight="22" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SpanBarItem">
            <Border Background="{Binding ChipBackground}" CornerRadius="3" Padding="4,1" ToolTip.Tip="{Binding Spoken}"
                    AutomationProperties.Name="{Binding Spoken}">
              <TextBlock Text="{Binding BarText}" Foreground="{Binding ChipForeground}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <ScrollViewer>
      <Grid ColumnDefinitions="56,*">
        <!-- Hour labels -->
        <ItemsControl ItemsSource="{Binding HourLabels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Height="48" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" Margin="0,0,6,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WeekDayViewModel">
              <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <ItemsControl ItemsSource="{Binding Entries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <c:TimelinePanel PixelsPerMinute="0.8"
                                       OriginMinute="{ReflectionBinding $parent[UserControl].DataContext.VisibleStartMinute}"
                                       TimelineHeight="{ReflectionBinding $parent[UserControl].DataContext.TimelineHeight}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimedEntryItem">
                      <Border Background="{Binding ChipBackground}" CornerRadius="3" Padding="3,1" Opacity="{Binding Opacity}"
                              ToolTip.Tip="{Binding Spoken}" AutomationProperties.Name="{Binding Spoken}" ClipToBounds="True">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Foreground="{Binding ChipForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding TimeText}" Foreground="{Binding ChipForeground}" FontSize="10" Opacity="0.85" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
