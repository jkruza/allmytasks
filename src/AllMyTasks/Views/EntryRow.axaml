<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.EntryRow"
             x:DataType="vm:EntryItem">
  <Grid ColumnDefinitions="4,150,*,Auto" ColumnSpacing="10" Margin="0,3" Opacity="{Binding Opacity}"
        AutomationProperties.Name="{Binding Spoken}" c:EntryActivation.Enabled="True" Background="Transparent">
    <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="2" />
    <TextBlock Grid.Column="1" Classes="small" Text="{Binding TimeText}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding Glyph}" IsVisible="{Binding IsTask}" />
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <PathIcon Data="M2,4 H11 V12 H2 Z M12,7 L16,4 V12 L12,9 Z" Width="14" Height="14" IsVisible="{Binding HasMeeting}" Opacity="0.7"
                  ToolTip.Tip="Online meeting" />
        <TextBlock Text="(tentative)" IsVisible="{Binding IsTentative}" Opacity="0.7" />
        <TextBlock Classes="overdue" Text="overdue" IsVisible="{Binding IsOverdue}" />
      </StackPanel>
      <TextBlock Classes="small" Text="{Binding Location}" IsVisible="{Binding HasLocation}" />
    </StackPanel>
    <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center">
      <TextBlock Classes="meta" Text="{Binding CollectionName}" />
    </Border>
  </Grid>
</UserControl>
