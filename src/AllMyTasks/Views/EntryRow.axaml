<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.EntryRow"
             x:DataType="vm:EntryItem">
  <Grid ColumnDefinitions="4,150,*,Auto" ColumnSpacing="10" Margin="0,3" Opacity="{Binding Opacity}"
        AutomationProperties.Name="{Binding Spoken}" c:EntryActivation.Enabled="True" Background="Transparent">
    <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="2" />
    <TextBlock Grid.Column="1" Text="{Binding TimeText}" VerticalAlignment="Center" Opacity="0.8" />
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding Glyph}" IsVisible="{Binding IsTask}" />
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="(tentative)" IsVisible="{Binding IsTentative}" Opacity="0.7" />
        <TextBlock Text="overdue" IsVisible="{Binding IsOverdue}" Foreground="IndianRed" FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock Text="{Binding Location}" IsVisible="{Binding HasLocation}" Opacity="0.7" FontSize="12" />
    </StackPanel>
    <Border Grid.Column="3" Padding="6,1" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" VerticalAlignment="Center">
      <TextBlock Text="{Binding CollectionName}" FontSize="11" />
    </Border>
  </Grid>
</UserControl>
