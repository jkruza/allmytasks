<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:views="using:AllMyTasks.Views"
             x:Class="AllMyTasks.Views.UpcomingView"
             x:DataType="vm:UpcomingViewModel">
  <Grid RowDefinitions="*,Auto">
    <TextBlock Text="Nothing coming up" IsVisible="{Binding IsEmpty}" Opacity="0.6" FontSize="16"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <!-- The only unbounded list, so it is virtualised. -->
    <ScrollViewer Grid.Row="0" Margin="24,12">
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.DataTemplates>
        <DataTemplate DataType="vm:DayGroupHeader">
          <TextBlock Text="{Binding Text}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,2" />
        </DataTemplate>
        <DataTemplate DataType="vm:EntryItem"><views:EntryRow /></DataTemplate>
      </ItemsControl.DataTemplates>
    </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="1" Content="Load more" Command="{ReflectionBinding $parent[Window].DataContext.LoadMoreCommand}"
            HorizontalAlignment="Center" Margin="0,0,0,12" IsVisible="{Binding !IsEmpty}" />
  </Grid>
</UserControl>
