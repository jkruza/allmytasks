<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AllMyTasks.ViewModels"
        xmlns:views="using:AllMyTasks.Views"
        x:Class="AllMyTasks.Views.MainWindow"
        x:DataType="vm:CalendarShellViewModel"
        Title="All My Tasks"
        Width="1100" Height="760" MinWidth="640" MinHeight="420">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <Button Content="‹" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanNavigate}"
                  AutomationProperties.Name="Previous" ToolTip.Tip="Previous (←)" />
          <Button Content="Today" Command="{Binding GoTodayCommand}" ToolTip.Tip="Today (T)" />
          <Button Content="›" Command="{Binding NextCommand}" IsEnabled="{Binding CanNavigate}"
                  AutomationProperties.Name="Next" ToolTip.Tip="Next (→)" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
          <ToggleButton Content="Day" IsChecked="{Binding IsDay, Mode=OneWay}"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:ViewMode.Day}" ToolTip.Tip="Day (D)" />
          <ToggleButton Content="Week" IsChecked="{Binding IsWeek, Mode=OneWay}"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:ViewMode.Week}" ToolTip.Tip="Week (W)" />
          <ToggleButton Content="Month" IsChecked="{Binding IsMonth, Mode=OneWay}"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:ViewMode.Month}" ToolTip.Tip="Month (M)" />
          <ToggleButton Content="Upcoming" IsChecked="{Binding IsUpcoming, Mode=OneWay}"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:ViewMode.Upcoming}" ToolTip.Tip="Upcoming (U)" />
          <ToggleButton Content="All tasks" IsChecked="{Binding IsTasks, Mode=OneWay}"
                        Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:ViewMode.Tasks}" ToolTip.Tip="All tasks (A)" />
        </StackPanel>
        <Button Grid.Column="3" Content="Filter ▾">
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="6" MinWidth="220">
                <TextBlock Text="Show" FontWeight="SemiBold" />
                <CheckBox Content="Events" IsChecked="{Binding ShowEvents}" />
                <CheckBox Content="Tasks" IsChecked="{Binding ShowTasks}" />
                <CheckBox Content="Completed tasks" IsChecked="{Binding ShowCompleted}" />
                <CheckBox Content="Hide weekends (week view)" IsChecked="{Binding HideWeekends}" />
                <Separator />
                <TextBlock Text="Calendars and lists" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Collections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollectionToggle">
                      <CheckBox IsChecked="{Binding IsVisible}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Accent}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSyncing}" Width="48" />
          <Button Command="{Binding OpenSourcesCommand}" ToolTip.Tip="Sources" AutomationProperties.Name="Sources">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="8" Height="8" CornerRadius="4" Background="IndianRed" VerticalAlignment="Center" IsVisible="{Binding HasProblems}" />
              <TextBlock Text="{Binding SyncSummary}" FontSize="12" />
            </StackPanel>
          </Button>
          <Button Content="⚙" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh (R)" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Details pane: one host for every kind of details; see docs/design/details-pane.md. -->
    <Border DockPanel.Dock="Right" Width="340" Padding="16,12" IsVisible="{Binding IsDetailsOpen}"
            BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Text="Details" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="CloseDetailsButton" Grid.Column="1" Content="✕" Command="{Binding CloseDetailsCommand}"
                  AutomationProperties.Name="Close details" ToolTip.Tip="Close (Esc)" />
        </Grid>
        <ContentControl Content="{Binding SelectedDetails}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:CalendarEntryDetailsViewModel"><views:CalendarEntryDetailsView /></DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </DockPanel>
    </Border>
    <ContentControl Content="{Binding Content}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:DayViewModel"><views:DayView /></DataTemplate>
        <DataTemplate DataType="vm:WeekViewModel"><views:WeekView /></DataTemplate>
        <DataTemplate DataType="vm:MonthViewModel"><views:MonthView /></DataTemplate>
        <DataTemplate DataType="vm:UpcomingViewModel"><views:UpcomingView /></DataTemplate>
        <DataTemplate DataType="vm:TasksViewModel"><views:TasksView /></DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</Window>
