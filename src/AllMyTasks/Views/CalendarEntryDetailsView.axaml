<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:core="using:AllMyTasks.Core.Views"
             x:Class="AllMyTasks.Views.CalendarEntryDetailsView"
             x:DataType="vm:CalendarEntryDetailsViewModel"
             AutomationProperties.Name="{Binding AutomationName}">
  <ScrollViewer>
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
        <Border Background="{Binding Accent}" CornerRadius="2" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{DynamicResource AmtFontSizeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
      </Grid>
      <StackPanel IsVisible="{Binding HasMeeting}" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="JoinMeeting" Content="{Binding MeetingLabel}" ToolTip.Tip="{Binding MeetingTooltip}" Click="OnJoinMeeting" />
          <Button x:Name="CopyMeetingLink" Content="Copy link" Click="OnCopyMeetingLink" />
        </StackPanel>
        <TextBlock Classes="meta" Text="{Binding MeetingHost}" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:DetailRow">
            <StackPanel Margin="0,0,0,8">
              <TextBlock Classes="meta" Text="{Binding Label}" />
              <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="OpenLink" Content="Open link" ToolTip.Tip="{Binding LinkTooltip}" IsVisible="{Binding HasLink}" HorizontalAlignment="Left" Click="OnOpenLink" />
      <StackPanel IsVisible="{Binding HasPeople}" Spacing="4">
        <TextBlock Classes="meta" Text="Attendees" />
        <ItemsControl ItemsSource="{Binding VisiblePeople}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:PersonLine">
              <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding Spoken}" ToolTip.Tip="{Binding Tooltip}">
                <TextBlock Text="{Binding Glyph}" Width="14" Foreground="{DynamicResource AmtMutedBrush}" />
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                <TextBlock Classes="small" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="small" Text="{Binding MoreAttendeesText}" IsVisible="{Binding HasMoreAttendees}" />
        <Button Content="{Binding ShowAllText}" IsVisible="{Binding CanShowAll}" Command="{Binding ShowAllCommand}" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel IsVisible="{Binding HasDescription}">
        <TextBlock Classes="meta" Text="Description" />
        <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
