<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AllMyTasks.Views.PinWindow"
        Title="All My Tasks" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="Body" TextWrapping="Wrap" />
    <TextBox x:Name="Pin" PasswordChar="●" PlaceholderText="PIN" />
    <TextBox x:Name="Confirm" PasswordChar="●" PlaceholderText="Repeat PIN" IsVisible="False" />
    <TextBlock x:Name="Error" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="Ok" Content="OK" IsDefault="True" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</Window>
