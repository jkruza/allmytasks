<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.SearchView"
             x:DataType="vm:SearchViewModel">
  <DockPanel Margin="12">
    <!-- Global search: one box over every event and task in the local cache. See docs/design/search-and-saved-filters.md. -->
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="QueryBox" Text="{Binding QueryText}" PlaceholderText="Search events and tasks (Esc to close)"
                 AutomationProperties.Name="Search events and tasks" />
        <Button Grid.Column="1" Classes="tool" Content="Close" Command="{Binding CloseCommand}" ToolTip.Tip="Close search (Esc)" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding Summary}" Opacity="0.7" />
        <TextBlock Text="{Binding HiddenText}" IsVisible="{Binding HasHidden}" Opacity="0.7" />
      </StackPanel>
    </StackPanel>
    <ListBox ItemsSource="{Binding Items}" SelectionMode="Single">
      <ListBox.DataTemplates>
        <DataTemplate DataType="vm:TaskGroupHeader">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,2">
            <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CountText}" Opacity="0.6" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SearchEventItem">
          <Grid ColumnDefinitions="4,200,*,Auto,Auto" ColumnSpacing="10" Margin="0,3" Opacity="{Binding Opacity}"
                AutomationProperties.Name="{Binding Spoken}" Background="Transparent" c:EntryActivation.Enabled="True">
            <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="2" />
            <TextBlock Grid.Column="1" Text="{Binding WhenText}" VerticalAlignment="Center" Opacity="0.8" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="3" Padding="6,1" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" VerticalAlignment="Center">
              <TextBlock Text="{Binding CollectionName}" FontSize="11" />
            </Border>
            <Button Grid.Column="4" Classes="tool" Content="Show in calendar" Command="{Binding ShowInCalendarCommand}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:SearchTaskItem">
          <Grid ColumnDefinitions="Auto,4,*,Auto,Auto" ColumnSpacing="10" Margin="0,3" Opacity="{Binding Opacity}"
                AutomationProperties.Name="{Binding Spoken}" Background="Transparent" c:EntryActivation.Enabled="True">
            <TextBlock Grid.Column="0" Text="{Binding Glyph}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="{Binding Accent}" CornerRadius="2" />
            <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding DueText}" VerticalAlignment="Center" Classes.overdue="{Binding IsOverdue}" />
            <Border Grid.Column="4" Padding="6,1" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" VerticalAlignment="Center">
              <TextBlock Text="{Binding CollectionName}" FontSize="11" />
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.DataTemplates>
      <ListBox.Styles>
        <Style Selector="TextBlock.overdue">
          <Setter Property="Foreground" Value="IndianRed" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </DockPanel>
</UserControl>
