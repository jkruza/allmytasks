<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AllMyTasks.ViewModels"
             xmlns:c="using:AllMyTasks.Controls"
             x:Class="AllMyTasks.Views.SearchView"
             x:DataType="vm:SearchViewModel">
  <DockPanel Margin="12">
    <!-- Global search: one box over every event and task in the local cache. See docs/design/search-and-saved-filters.md. -->
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="QueryBox" Text="{Binding QueryText}" PlaceholderText="Search events and tasks (Esc to close)"
                 AutomationProperties.Name="Search events and tasks" />
        <Button Grid.Column="1" Classes="tool" Content="Close" Command="{Binding CloseCommand}" ToolTip.Tip="Close search (Esc)" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="small" Text="{Binding Summary}" />
        <TextBlock Classes="small" Text="{Binding HiddenText}" IsVisible="{Binding HasHidden}" />
      </StackPanel>
    </StackPanel>
    <ListBox ItemsSource="{Binding Items}" SelectionMode="Single">
      <ListBox.DataTemplates>
        <DataTemplate DataType="vm:TaskGroupHeader">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,2">
            <TextBlock Classes="section" Text="{Binding Text}" />
            <TextBlock Classes="meta" Text="{Binding CountText}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SearchEventItem">
          <Grid ColumnDefinitions="200,Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,4" Opacity="{Binding Opacity}"
                AutomationProperties.Name="{Binding Spoken}" Background="Transparent" c:EntryActivation.Enabled="True">
            <TextBlock Grid.Column="0" Classes="small" Text="{Binding WhenText}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="dot" Background="{Binding Accent}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="small" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center">
              <TextBlock Classes="meta" Text="{Binding CollectionName}" />
            </Border>
            <Button Grid.Column="4" Classes="tool" Content="Show in calendar" Command="{Binding ShowInCalendarCommand}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:SearchTaskItem">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,4" Opacity="{Binding Opacity}"
                AutomationProperties.Name="{Binding Spoken}" Background="Transparent" c:EntryActivation.Enabled="True">
            <TextBlock Grid.Column="0" Text="{Binding Glyph}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="dot" Background="{Binding Accent}" />
            <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Classes="small" Text="{Binding DueText}" VerticalAlignment="Center" Classes.overdue="{Binding IsOverdue}" />
            <Border Grid.Column="4" Classes="badge" VerticalAlignment="Center">
              <TextBlock Classes="meta" Text="{Binding CollectionName}" />
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>
  </DockPanel>
</UserControl>
