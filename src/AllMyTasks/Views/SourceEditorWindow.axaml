<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AllMyTasks.ViewModels"
        xmlns:core="using:AllMyTasks.Core.Sync"
        x:Class="AllMyTasks.Views.SourceEditorWindow"
        x:DataType="vm:SourceEditorViewModel"
        Title="{Binding Title}" Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="title" Text="{Binding Title}" />
    <StackPanel Spacing="4" IsVisible="{Binding !IsEdit}">
      <TextBlock Text="Type" />
      <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="core:ISourceFactory"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Text="Name *" />
      <TextBox Text="{Binding Name}" />
      <TextBlock Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Fields}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FieldViewModel">
          <StackPanel Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding Label}" IsVisible="{Binding IsText}" />
            <TextBox Text="{Binding Value}" PasswordChar="{Binding PasswordChar}" PlaceholderText="{Binding Placeholder}" IsVisible="{Binding IsText}" />
            <CheckBox Content="{Binding Label}" IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}" />
            <TextBlock Classes="small" Text="{Binding Help}" TextWrapping="Wrap"
                       IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="error" Text="{Binding SaveError}"
               IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Save" IsDefault="True" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>
