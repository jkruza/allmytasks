<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AllMyTasks.Providers.Google</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AllMyTasks.Core\AllMyTasks.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AllMyTasks.Providers.Google.Tests" />
  </ItemGroup>
  <!-- The default OAuth client is injected at build time (AMT_GOOGLE_CLIENT_ID, AMT_GOOGLE_CLIENT_SECRET) and never committed. -->
  <ItemGroup Condition="'$(AMT_GOOGLE_CLIENT_ID)' != ''">
    <AssemblyMetadata Include="GoogleClientId" Value="$(AMT_GOOGLE_CLIENT_ID)" />
  </ItemGroup>
  <ItemGroup Condition="'$(AMT_GOOGLE_CLIENT_ID)' != '' And '$(AMT_GOOGLE_CLIENT_SECRET)' != ''">
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(AMT_GOOGLE_CLIENT_SECRET)" />
  </ItemGroup>
</Project>
