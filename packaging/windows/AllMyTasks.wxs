<?xml version="1.0" encoding="utf-8"?>
<!-- Per-user MSI (no admin rights): installs to %LOCALAPPDATA%\Programs\AllMyTasks. Built by build.ps1, which passes
     Version and SourceDir. See docs/design/packaging.md. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="All My Tasks"
           Manufacturer="Jarosław Kruza and contributors"
           Version="$(Version)"
           UpgradeCode="3f0a1c52-6d4e-4b8b-9a57-2c1d8e7f4a10"
           Scope="perUser"
           Language="1033">
    <SummaryInformation Description="Calendars and tasks from many providers in one place" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of All My Tasks is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Both default to off; set on the command line (msiexec ... DESKTOPSHORTCUT=1 STARTWITHWINDOWS=1). -->
    <Property Id="DESKTOPSHORTCUT" Value="0" />
    <Property Id="STARTWITHWINDOWS" Value="0" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsLocalFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="AllMyTasks" />
      </Directory>
    </StandardDirectory>

    <!-- Close a running instance before replacing the executable. -->
    <util:CloseApplication Id="CloseAllMyTasks" Target="AllMyTasks.exe" CloseMessage="yes" RebootPrompt="no" TerminateProcess="0" />

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="5b0c6d1e-2a3f-4c9a-8e11-7a2b9d3c4e51">
      <File Id="AllMyTasksExe" Source="$(SourceDir)\AllMyTasks.exe" KeyPath="yes" />
    </Component>

    <!-- The Start menu shortcut carries the app user model id that toast notifications are attributed to. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="9d2e7a14-3b65-4f08-a1c3-0e5f6b7c8d92">
        <Shortcut Id="StartMenuShortcut" Name="All My Tasks" Description="Calendars and tasks from many providers"
                  Target="[INSTALLFOLDER]AllMyTasks.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="com.jkruza.allmytasks" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\AllMyTasks\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="c47b8e30-5f21-49d6-b7a0-1d3e5f7a9b24" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="All My Tasks" Target="[INSTALLFOLDER]AllMyTasks.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="com.jkruza.allmytasks" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\AllMyTasks\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Component Id="StartWithWindowsComponent" Directory="INSTALLFOLDER" Guid="e81f2a43-7c90-4d15-b6e2-3a4b5c6d7e08" Condition="STARTWITHWINDOWS = &quot;1&quot;">
      <!-- Same value name and quoting as the app's own launch-at-login setting; the tray-only start option as its default. -->
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="AllMyTasks" Type="string"
                     Value="&quot;[INSTALLFOLDER]AllMyTasks.exe&quot; --tray" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="All My Tasks" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="StartWithWindowsComponent" />
    </Feature>
  </Package>
</Wix>
